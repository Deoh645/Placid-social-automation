      "id": "b4196e82-2d68-410d-b83f-c37930d7382c",
      "name": "Gemini Model (Generate)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        2720,
        864
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "esrPCeeIb2ga03fr",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=SOURCE TITLE: {{ $('Parse Article').first().json.title }}\nSOURCE DESCRIPTION: {{ $('Parse Article').first().json.description }}\nSOURCE TEXT: {{ $('Parse Article').first().json.body }}\n\nPOST TO REVIEW:\n{{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a strict compliance reviewer for social media posts about medical tourism. Compare the POST to the SOURCE. FAIL the post if it: makes a medical claim; promises or implies an outcome; states or implies a price not in the SOURCE; or states any fact that is not supported by the SOURCE. Otherwise PASS. Reply with ONLY a JSON object, no other text: {\"pass\": true, \"issues\": []} or {\"pass\": false, \"issues\": [\"short reason\"]}."
            }
          ]
        }
      },
      "id": "5988e17c-d0f5-4d12-85e9-3583f5d8033a",
      "name": "Check Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2960,
        672
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0
        }
      },
      "id": "f50534e6-9811-4ade-90d2-f74682f24475",
      "name": "Gemini Model (Check)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        2960,
        864
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "esrPCeeIb2ga03fr",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('Parse Article').first().json;\nconst draft = ($('Generate Post').first().json.text || '').trim();\nconst raw = $input.first().json.text || '';\n\n// Second-pass LLM verdict\nlet llm = { pass: false, issues: ['Reviewer output could not be parsed'] };\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) llm = JSON.parse(m[0]);\n} catch (e) {}\n\nconst issues = [...(llm.issues || [])];\n\n// Rule 1: length before the link\nif (draft.length > 500) issues.push('Post is over 500 characters (' + draft.length + ')');\n\n// Rule 2: 3-5 hashtags\nconst tags = draft.match(/#\\w+/g) || [];\nif (tags.length < 3 || tags.length > 5) issues.push('Needs 3-5 hashtags, found ' + tags.length);\n\n// Rule 3: banned claim wording\nconst banned = /(\\bcure[sd]?\\b|\\bguarantee[sd]?\\b|100%|risk-free|\\bmiracle\\b|\\bpainless\\b|no side effects|permanent results|safe and effective|world-class|\\bbest\\b|\\bleading\\b|top-rated|state-of-the-art|life-saving|saves lives|high-quality|\\brenowned\\b|\\bexceptional\\b|\\bunmatched\\b|\\bskillful\\b|\\besteemed\\b)/i;\nconst hit = draft.match(banned);\nif (hit) issues.push('Banned claim wording: ' + hit[0]);\n\n// Rule 4: prices that are not in the source\nconst price = draft.match(/(\\$|USD|EUR|€|£)\\s?\\d[\\d,.]*|\\d[\\d,.]*\\s?(USD|EUR|dollars)/i);\nconst sourceText = src.title + ' ' + src.description + ' ' + src.body;\nif (price && !sourceText.includes(price[0])) issues.push('Possible invented price: ' + price[0]);\n\nif (!src.enough_content) issues.push('Not enough source text on the page');\n\nconst approved = llm.pass === true && issues.length === 0;\n\nreturn [{ json: {\n  approved, issues,\n  url: src.url, title: src.title, image: src.image,\n  post_text: draft,\n  final_text: draft + '\\n\\n' + src.url\n} }];"
      },
