    {
      "parameters": {
        "jsCode": "const root = $input.first().json;\nconst urlset = root.urlset || {};\nlet entries = urlset.url || [];\nif (!Array.isArray(entries)) entries = [entries];\n\nconst cleaned = entries\n  .map(e => ({ url: (e.loc || '').toString().trim(), lastmod: e.lastmod ? e.lastmod.toString().trim() : null }))\n  .filter(e => e.url.startsWith('https://www.placidway.com/'));\n\n// Respect robots.txt: skip anything under a disallowed path\nconst blocked = ['/api/v1/', '/ajax/', '/data/', '/blog_old/', '/blog_include/', '/uploads/', '/solutions/', '/language/'];\nconst allowed = cleaned.filter(e => !blocked.some(p => e.url.includes(p)));\n\nallowed.sort((a, b) => (b.lastmod || '').localeCompare(a.lastmod || ''));\nreturn allowed.slice(0, 20).map(e => ({ json: e }));"
      },
