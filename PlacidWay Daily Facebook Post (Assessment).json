    {
      "parameters": {
        "jsCode": "// Rows already logged (posted, drafted or rejected) - the never-post-twice store\nconst logged = new Set($input.all().map(i => i.json.url).filter(Boolean));\n\nconst candidates = $('Extract Recent URLs').all()\n  .map(i => i.json)\n  .filter(c => !logged.has(c.url));\n\nif (candidates.length === 0) {\n  return [{ json: { none: true } }];\n}\nreturn [{ json: { none: false, url: candidates[0].url, lastmod: candidates[0].lastmod } }];"
      },
